# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
# Use local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/kairo
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kairo?retryWrites=true&w=majority

# JWT Secrets
# Generate secure random strings for production
JWT_SECRET=kairo-super-secret-jwt-key-change-in-production-2024
JWT_REFRESH_SECRET=kairo-refresh-secret-change-in-production-2024
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Google OAuth (Optional - for future implementation)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# AWS S3 (Optional - for file uploads in production)
# Leave empty to use local storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# AI Provider Configuration
# Options: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (Alternative to OpenAI)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
